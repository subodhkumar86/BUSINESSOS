# cPanel / Passenger deployment values for BusinessOS.
#
# Two ways to provide these to the application:
#   1. cPanel > Setup Node.js App > Environment variables (recommended; they win over this file).
#   2. Copy this file to ".env" in the application root (app.cjs loads it; .env is never committed).
#
# Never commit real credentials. Replace every placeholder below.

NODE_ENV=production

# Managed PostgreSQL. Use the TLS connection string from your provider.
# This role must be a normal login role: not a superuser and without BYPASSRLS.
# BusinessOS refuses to start otherwise.
DATABASE_URL=postgresql://businessos_app:CHANGE_ME@db.example.com:5432/businessos?sslmode=require

# Managed Redis with TLS (sessions, login throttling and rate limits use EVAL).
REDIS_URL=rediss://default:CHANGE_ME@redis.example.com:6379

# Exact origin the browser uses. Comma-separated for extra origins.
# Must be HTTPS with no trailing slash when NODE_ENV=production.
APP_ORIGIN=https://demo.businessos.swad.cloud

# Required in production: the session cookie is only sent over HTTPS.
COOKIE_SECURE=true

# Keep session cookies "strict" when the API and SPA share this one origin.
# Use "none" only for a split deployment where the SPA is on another domain.
COOKIE_SAME_SITE=strict

# Passenger provides the socket; leave PORT and API_HOST unset in cPanel.

# Optional: enables server-side DeepSeek enrichment for /api/v1/ai/ask.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# Required only when a tenant stores provider credentials through Settings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TENANT_CONNECTOR_ENCRYPTION_KEY=

# Notification delivery stays disabled by default (messages remain in the audited outbox).
# NOTIFY_PROVIDER=webhook
# NOTIFY_WEBHOOK_URL=
# DELIVERY_WEBHOOK_SECRET=

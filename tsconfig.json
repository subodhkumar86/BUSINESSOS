{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "app",
    "src",
    "server/mongo",
    "scripts/mongo-setup.ts",
    "scripts/provision-super-admin.ts",
    "scripts/deliver-outbox.ts",
    "scripts/run-automation.ts",
    "tests/mongo*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".cache/next-live/types/**/*.ts",
    ".cache/next-live/dev/types/**/*.ts",
    ".cache/next-demo/types/**/*.ts",
    ".cache/next-demo/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

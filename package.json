{
  "name": "businessos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "lint": "oxlint",
    "test": "node --test tests/domain.test.js tests/security.test.ts tests/inventory.test.ts tests/completion.test.ts tests/completion2.test.ts tests/tax.test.ts tests/deepseek.test.ts tests/reconciliation.test.ts tests/recruitment.test.ts tests/workflows.test.ts tests/exports.test.ts tests/shipments.test.ts tests/returns.test.ts tests/budget-rfq.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/mongo-setup.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/mongo-api.test.ts",
    "format": "prettier --write app src server scripts tests",
    "test:e2e": "playwright test",
    "start": "next start"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "^16.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}

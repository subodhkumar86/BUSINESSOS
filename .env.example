# Local development values only. Production credentials belong in a secret manager.
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
DATABASE_URL=postgresql://businessos_app:businessos_dev_only@127.0.0.1:5433/businessos
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
PORT=3001
API_HOST=127.0.0.1
COOKIE_SECURE=false
# Optional for a separately hosted frontend, for example https://api.example.com.
# VITE_API_URL=
# Future adapters: configure only when their modules are implemented.
# S3_ENDPOINT=
# S3_BUCKET=
# OPENSEARCH_URL=
# PAYMENT_PROVIDER=
# AI_GATEWAY_URL=

# Notification delivery is disabled by default: messages remain in the audited outbox.
# To enable a provider bridge, configure a server-controlled HTTPS endpoint that accepts
# signed POST payloads; never put provider secrets in the browser.
# NOTIFY_PROVIDER=webhook
# NOTIFY_WEBHOOK_URL=https://notifications.example.com/businessos/deliver
# DELIVERY_WEBHOOK_SECRET=replace-with-a-secret-manager-value-at-least-32-characters-long

# Local password recovery only; never returned in production.
# RETURN_RESET_TOKEN=true

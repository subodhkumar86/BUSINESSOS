# Local development. MongoDB must be Atlas or a replica set for transactions.
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.dfb2b.mongodb.net/business?retryWrites=true&w=majority"
MONGODB_DB=business
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
# Vercel: APP_ORIGIN=https://businessos-topaz.vercel.app and COOKIE_SECURE=true.
# Set a random 32-byte base64 (or 64-character hex) secret for MFA/recovery.
# Keep this key stable and store it in your deployment secret manager.
APP_ENCRYPTION_KEY=
# Connector credentials use this key (32 bytes, base64 or hex).
CONNECTOR_ENCRYPTION_KEY=
# Development/test only; never enable token responses in production.
ALLOW_DEVELOPMENT_RESET_TOKENS=false
# Configure your delivery webhook and run the outbox worker to send queued mail.
NOTIFY_PROVIDER=local-log
NOTIFY_WEBHOOK_URL=
DELIVERY_WEBHOOK_SECRET=
# Protects /api/v1/internal/outbox/run and /api/v1/internal/automation/run.
# Configure deployment scheduling separately; saving a schedule alone does not run it.
CRON_SECRET=
